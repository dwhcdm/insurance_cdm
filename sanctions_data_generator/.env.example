# Snowflake Connection Parameters
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=SANCTIONS_DATA_ENGINEER
SNOWFLAKE_WAREHOUSE=SANCTIONS_LOADING_WH_M
SNOWFLAKE_DATABASE=SANCTIONS_DEV
SNOWFLAKE_SCHEMA=RAW

# Optional: Key Pair Authentication (recommended for production)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase

# Environment Configuration
ENVIRONMENT=dev
DATA_OUTPUT_DIR=./generated_data
